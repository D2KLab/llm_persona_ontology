    skos:prefLabel "everyday"@en .

llmpv:professionalRegister
    a skos:Concept ;
    skos:inScheme llmpv:VocabularyRegisterScheme ;
    skos:prefLabel "professional"@en .

llmpv:academicRegister
    a skos:Concept ;
    skos:inScheme llmpv:VocabularyRegisterScheme ;
    skos:prefLabel "academic"@en .

llmpv:technicalRegister
    a skos:Concept ;
    skos:inScheme llmpv:VocabularyRegisterScheme ;
    skos:prefLabel "technical"@en .

llmpv:literaryRegister
    a skos:Concept ;
    skos:inScheme llmpv:VocabularyRegisterScheme ;
    skos:prefLabel "literary"@en .


#################################################################
# Sentence complexity
#################################################################

llmpv:SentenceComplexityScheme
    a skos:ConceptScheme ;
    skos:prefLabel "LLMP sentence complexity vocabulary"@en .

llmpv:SentenceComplexityLevels
    a skos:OrderedCollection ;
    skos:prefLabel "Ordered sentence complexity levels"@en ;
    skos:memberList (
        llmpv:simpleSentenceComplexity
        llmpv:moderateSentenceComplexity
        llmpv:complexSentenceComplexity
    ) .

llmpv:simpleSentenceComplexity
    a skos:Concept ;
    skos:inScheme llmpv:SentenceComplexityScheme ;
    skos:prefLabel "simple"@en .

llmpv:moderateSentenceComplexity
    a skos:Concept ;
    skos:inScheme llmpv:SentenceComplexityScheme ;
    skos:prefLabel "moderate"@en .

llmpv:complexSentenceComplexity
    a skos:Concept ;
    skos:inScheme llmpv:SentenceComplexityScheme ;
    skos:prefLabel "complex"@en .


