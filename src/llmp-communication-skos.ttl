#################################################################
# Repair style
#################################################################

llmpv:RepairStyleScheme
    a skos:ConceptScheme ;
    skos:prefLabel "LLMP repair style vocabulary"@en .

llmpv:ignoresMisunderstanding
    a skos:Concept ;
    skos:inScheme llmpv:RepairStyleScheme ;
    skos:prefLabel "ignores misunderstanding"@en .

llmpv:asksClarification
    a skos:Concept ;
    skos:inScheme llmpv:RepairStyleScheme ;
    skos:prefLabel "asks clarification"@en .

llmpv:selfCorrects
    a skos:Concept ;
    skos:inScheme llmpv:RepairStyleScheme ;
    skos:prefLabel "self-corrects"@en .

llmpv:reformulates
    a skos:Concept ;
    skos:inScheme llmpv:RepairStyleScheme ;
    skos:prefLabel "reformulates"@en .

llmpv:confirmsUnderstanding
    a skos:Concept ;
    skos:inScheme llmpv:RepairStyleScheme ;
    skos:prefLabel "confirms understanding"@en .


#################################################################
# Rhetorical style vocabulary
#################################################################

llmpv:RhetoricalStyleScheme
    a skos:ConceptScheme ;
    skos:prefLabel "LLMP rhetorical style vocabulary"@en ;
    skos:definition "Controlled vocabulary of rhetorical styles and techniques that may characterise argumentation, explanation, persuasion, or multiple rhetorical functions."@en .


#################################################################
# Collections by rhetorical function
#################################################################

llmpv:ArgumentationStyles
    a skos:Collection ;
    skos:prefLabel "argumentation styles"@en ;
    skos:definition "Rhetorical styles commonly used to support claims, conclusions, or positions."@en ;
    skos:member
        llmpv:stepByStep ,
        llmpv:evidenceBased ,
        llmpv:exampleBased ,
        llmpv:authorityBased ,
        llmpv:analogyBased ,
        llmpv:experienceBased ,
        llmpv:valueBased ,
        llmpv:rational .

llmpv:ExplanationStyles
    a skos:Collection ;
    skos:prefLabel "explanation styles"@en ;
    skos:definition "Rhetorical styles commonly used to make concepts, information, or reasoning understandable."@en ;
    skos:member
        llmpv:stepByStep ,
        llmpv:conciseSummary ,
        llmpv:exampleBased ,
        llmpv:analogyBased ,
        llmpv:evidenceBased ,
        llmpv:technical ,
        llmpv:simplified .

llmpv:PersuasionStyles
    a skos:Collection ;
    skos:prefLabel "persuasion styles"@en ;
    skos:definition "Rhetorical styles commonly used when attempting to influence, motivate, or change an interlocutor's position or behaviour."@en ;
    skos:member
        llmpv:nonPersuasive ,
        llmpv:stepByStep ,
        llmpv:evidenceBased ,
        llmpv:authorityBased ,
        llmpv:analogyBased ,
        llmpv:experienceBased ,
        llmpv:valueBased ,
        llmpv:rational ,
        llmpv:emotional ,
        llmpv:socialProofBased ,
        llmpv:motivational .


#################################################################
# General rhetorical techniques
#################################################################

llmpv:stepByStep
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "step-by-step"@en ;
    skos:definition "Organises communication as an explicit sequence of successive steps, stages, or reasoning moves."@en .

llmpv:evidenceBased
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "evidence-based"@en ;
    skos:definition "Uses evidence, data, or substantiated information as a primary rhetorical mechanism."@en .

llmpv:exampleBased
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "example-based"@en ;
    skos:definition "Uses concrete examples or cases as a primary means of illustrating, supporting, or communicating a point."@en .

llmpv:authorityBased
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "authority-based"@en ;
    skos:definition "Relies on recognised experts, institutions, sources, or other forms of authority to support or strengthen communication."@en .

llmpv:analogyBased
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "analogy-based"@en ;
    skos:definition "Uses analogies or comparisons with other situations or concepts as a significant rhetorical mechanism."@en .

llmpv:experienceBased
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "experience-based"@en ;
    skos:definition "Draws primarily on experience, precedent, practical knowledge, or previously encountered cases."@en .

llmpv:valueBased
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "value-based"@en ;
    skos:definition "Frames communication in terms of values, principles, norms, ideals, or priorities."@en .

llmpv:rational
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "rational"@en ;
    skos:definition "Emphasises logical relationships, reasons, consequences, and explicit justification."@en .


#################################################################
# Styles particularly useful for explanation
#################################################################

llmpv:conciseSummary
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "concise summary"@en ;
    skos:definition "Communicates the main points in a compact form while omitting most secondary detail."@en .

llmpv:technical
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "technical"@en ;
    skos:definition "Uses specialised concepts, terminology, distinctions, or technical detail appropriate to the subject matter."@en .

llmpv:simplified
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "simplified"@en ;
    skos:definition "Reduces complexity and presents information in a form intended to be easier to understand."@en .


#################################################################
# Styles particularly useful for persuasion
#################################################################

llmpv:nonPersuasive
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "non-persuasive"@en ;
    skos:definition "Avoids deliberately attempting to change an interlocutor's opinion, attitude, or behaviour."@en .

llmpv:emotional
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "emotional"@en ;
    skos:definition "Uses emotional framing or affective appeal as a significant rhetorical mechanism."@en .

llmpv:socialProofBased
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "social-proof-based"@en ;
    skos:definition "Invokes the behaviour, endorsement, acceptance, or experience of other people or groups as support for a position or action."@en .

llmpv:motivational
    a skos:Concept ;
    skos:inScheme llmpv:RhetoricalStyleScheme ;
    skos:prefLabel "motivational"@en ;
    skos:definition "Seeks to encourage action, persistence, confidence, or engagement through supportive or goal-oriented rhetoric."@en .



