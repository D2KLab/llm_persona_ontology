@prefix llmpv: <https://w3id.org/llm-persona/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# Communicative role vocabulary
#################################################################

llmpv:CommunicativeRoleScheme
    a skos:ConceptScheme ;
    skos:prefLabel "LLMP communicative role vocabulary"@en ;
    skos:definition "Controlled vocabulary of roles that a persona or interlocutor may assume within a communicative tenor."@en ;
    skos:hasTopConcept
        llmpv:ExpertiseRole ,
        llmpv:InteractionRole ,
        llmpv:ServiceRole ,
        llmpv:HierarchicalRole ,
        llmpv:SocialRelationRole .


#################################################################
# Role categories
#################################################################

llmpv:ExpertiseRole
    a skos:Concept ;
    skos:topConceptOf llmpv:CommunicativeRoleScheme ;
    skos:prefLabel "expertise role"@en ;
    skos:definition "A communicative role characterised by the relative knowledge or expertise of an interlocutor."@en .

llmpv:InteractionRole
    a skos:Concept ;
    skos:topConceptOf llmpv:CommunicativeRoleScheme ;
    skos:prefLabel "interaction role"@en ;
    skos:definition "A communicative role defined by the function assumed within an interaction."@en .

llmpv:ServiceRole
    a skos:Concept ;
    skos:topConceptOf llmpv:CommunicativeRoleScheme ;
    skos:prefLabel "service role"@en ;
    skos:definition "A communicative role associated with requesting or providing a service."@en .

llmpv:HierarchicalRole
    a skos:Concept ;
    skos:topConceptOf llmpv:CommunicativeRoleScheme ;
    skos:prefLabel "hierarchical role"@en ;
    skos:definition "A communicative role characterised by relative authority or hierarchical position."@en .

llmpv:SocialRelationRole
    a skos:Concept ;
    skos:topConceptOf llmpv:CommunicativeRoleScheme ;
    skos:prefLabel "social relation role"@en ;
    skos:definition "A communicative role characterised by social proximity or an interpersonal relationship."@en .


#################################################################
# Expertise roles
#################################################################

llmpv:expertRole
    a skos:Concept ;
    skos:inScheme llmpv:CommunicativeRoleScheme ;
    skos:broader llmpv:ExpertiseRole ;
    skos:prefLabel "expert"@en ;
    skos:definition "A role in which the participant is treated as having comparatively high expertise relevant to the interaction."@en .

llmpv:noviceRole
    a skos:Concept ;
    skos:inScheme llmpv:CommunicativeRoleScheme ;
    skos:broader llmpv:ExpertiseRole ;
    skos:prefLabel "novice"@en ;
    skos:definition "A role in which the participant is treated as having comparatively limited expertise relevant to the interaction."@en .


#################################################################
# Interaction roles
#################################################################

llmpv:assistantRole
    a skos:Concept ;
    skos:inScheme llmpv:CommunicativeRoleScheme ;
    skos:broader llmpv:InteractionRole ;
    skos:prefLabel "assistant"@en ;
    skos:definition "A role centred on helping or supporting another participant in achieving their goals."@en .

llmpv:userRole
    a skos:Concept ;
    skos:inScheme llmpv:CommunicativeRoleScheme ;
    skos:broader llmpv:InteractionRole ;
    skos:prefLabel "user"@en ;
    skos:definition "A role representing the participant making use of an assistant, system, or interactive service."@en .


#################################################################
# Service roles
#################################################################

llmpv:customerRole
    a skos:Concept ;
    skos:inScheme llmpv:CommunicativeRoleScheme ;
    skos:broader llmpv:ServiceRole ;
    skos:prefLabel "customer"@en ;
    skos:definition "A role representing a participant requesting, purchasing, or receiving a service."@en .

llmpv:serviceAgentRole
    a skos:Concept ;
    skos:inScheme llmpv:CommunicativeRoleScheme ;
    skos:broader llmpv:ServiceRole ;
    skos:prefLabel "service agent"@en ;
    skos:definition "A role representing a participant providing assistance or service on behalf of an organisation or system."@en .


#################################################################
# Hierarchical roles
#################################################################

llmpv:authorityRole
    a skos:Concept ;
    skos:inScheme llmpv:CommunicativeRoleScheme ;
    skos:broader llmpv:HierarchicalRole ;
    skos:prefLabel "authority"@en ;
    skos:definition "A role characterised by comparatively greater authority, decision power, or hierarchical status."@en .

llmpv:subordinateRole
    a skos:Concept ;
    skos:inScheme llmpv:CommunicativeRoleScheme ;
    skos:broader llmpv:HierarchicalRole ;
    skos:prefLabel "subordinate"@en ;
    skos:definition "A role characterised by comparatively lower authority or hierarchical status relative to another participant."@en .


#################################################################
# Social relation roles
#################################################################

llmpv:peerRole
    a skos:Concept ;
    skos:inScheme llmpv:CommunicativeRoleScheme ;
    skos:broader llmpv:SocialRelationRole ;
    skos:prefLabel "peer"@en ;
    skos:definition "A role in which participants are treated as having broadly comparable social status within the interaction."@en .

llmpv:friendRole
    a skos:Concept ;
    skos:inScheme llmpv:CommunicativeRoleScheme ;
    skos:broader llmpv:peerRole ;
    skos:prefLabel "friend"@en ;
    skos:definition "A peer role characterised by an informal and socially close interpersonal relationship."@en .


#################################################################
# Communication channel
#################################################################

llmpv:CommunicationChannelScheme
    a skos:ConceptScheme ;
    skos:prefLabel "LLMP communication channel vocabulary"@en ;
    skos:definition "Controlled vocabulary describing the channel or medium through which an LLM persona communicates with an interlocutor or audience."@en .


llmpv:textChat
    a skos:Concept ;
    skos:inScheme llmpv:CommunicationChannelScheme ;
    skos:prefLabel "text chat"@en ;
    skos:definition "Written communication conducted through an interactive conversational interface, typically involving relatively rapid exchanges."@en .


llmpv:spokenCommunication
    a skos:Concept ;
    skos:inScheme llmpv:CommunicationChannelScheme ;
    skos:prefLabel "spoken communication"@en ;
    skos:definition "Communication realised primarily through spoken language or voice interaction."@en .


llmpv:email
    a skos:Concept ;
    skos:inScheme llmpv:CommunicationChannelScheme ;
    skos:prefLabel "email"@en ;
    skos:definition "Asynchronous written communication structured as electronic correspondence."@en .


llmpv:document
    a skos:Concept ;
    skos:inScheme llmpv:CommunicationChannelScheme ;
    skos:prefLabel "document"@en ;
    skos:definition "Communication realised through a structured written document intended to be read as a relatively self-contained artefact."@en .


llmpv:socialMedia
    a skos:Concept ;
    skos:inScheme llmpv:CommunicationChannelScheme ;
    skos:prefLabel "social media"@en ;
    skos:definition "Communication realised through a social media platform, including posts, comments, or other platform-specific interactions."@en .


llmpv:multimodalInteraction
    a skos:Concept ;
    skos:inScheme llmpv:CommunicationChannelScheme ;
    skos:prefLabel "multimodal interaction"@en ;
    skos:definition "Communication combining multiple modalities, such as text, speech, images, audio, or video, within the same interaction."@en .

#################################################################
# Discourse mode
#################################################################

llmpv:DiscourseModeScheme
    a skos:ConceptScheme ;
    skos:prefLabel "LLMP discourse mode vocabulary"@en ;
    skos:definition "Controlled vocabulary describing the general organisation of discourse."@en .

llmpv:narrativeDiscourse
    a skos:Concept ;
    skos:inScheme llmpv:DiscourseModeScheme ;
    skos:prefLabel "narrative"@en .

llmpv:descriptiveDiscourse
    a skos:Concept ;
    skos:inScheme llmpv:DiscourseModeScheme ;
    skos:prefLabel "descriptive"@en .

llmpv:explanatoryDiscourse
    a skos:Concept ;
    skos:inScheme llmpv:DiscourseModeScheme ;
    skos:prefLabel "explanatory"@en .

llmpv:argumentativeDiscourse
    a skos:Concept ;
    skos:inScheme llmpv:DiscourseModeScheme ;
    skos:prefLabel "argumentative"@en .

llmpv:proceduralDiscourse
    a skos:Concept ;
    skos:inScheme llmpv:DiscourseModeScheme ;
    skos:prefLabel "procedural"@en .

llmpv:dialogicDiscourse
    a skos:Concept ;
    skos:inScheme llmpv:DiscourseModeScheme ;
    skos:prefLabel "dialogic"@en .

llmpv:reflectiveDiscourse
    a skos:Concept ;
    skos:inScheme llmpv:DiscourseModeScheme ;
    skos:prefLabel "reflective"@en .


# Turn-taking style
#################################################################

llmpv:TurnTakingStyleScheme
    a skos:ConceptScheme ;
