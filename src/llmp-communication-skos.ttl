llmpv:reflectiveTurnTaking
    a skos:Concept ;
    skos:inScheme llmpv:TurnTakingStyleScheme ;
    skos:prefLabel "reflective"@en .


#################################################################
# Question style
#################################################################

llmpv:QuestionStyleScheme
    a skos:ConceptScheme ;
    skos:prefLabel "LLMP question style vocabulary"@en .

llmpv:rareQuestions
    a skos:Concept ;
    skos:inScheme llmpv:QuestionStyleScheme ;
