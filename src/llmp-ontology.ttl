@prefix : <https://w3id.org/llm-persona#> .
@prefix bio: <http://purl.org/vocab/bio/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rel: <http://purl.org/vocab/relationship/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix llmp: <https://w3id.org/llm-persona#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/llm-persona> rdf:type owl:Ontology ;
                           owl:versionIRI <https://w3id.org/llm-persona/0.1.1> ;
                           dcterms:created "2026-06-12"^^xsd:date ;
                           dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                           dcterms:modified "2026-09-24"^^xsd:date ;
                           dcterms:title "LLM Persona Ontology"@en ;
                           vann:preferredNamespacePrefix "llmp" ;
                           vann:preferredNamespaceUri "https://w3id.org/llm-persona#" ;
                           rdfs:label "LLM Persona Ontology"@en ;
                           owl:versionInfo "0.1.1" .


#################################################################
#    Object Properties
#################################################################


llmp:assessesTrait rdf:type owl:ObjectProperty ;
                   rdfs:domain llmp:TraitAssessment ;
                   rdfs:range skos:Concept ;
                   rdfs:comment "Links a trait assessment to the Big Five trait being assessed. The value should normally be a concept from the LLMP Big Five trait vocabulary."@en ;
                   rdfs:label "assesses trait"@en .



llmp:hasAchievementEvent rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf llmp:hasLifeEvent ;
                         rdfs:domain llmp:LLMPersona ;
                         rdfs:range bio:Event ;
                         rdfs:comment "Links an LLM persona to an event in which it attained, completed, received, created, discovered, or otherwise achieved something significant."@en ;
                         rdfs:label "has achievement event"@en .



llmp:hasAffiliation rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf llmp:hasSocialIdentityFeature ;
                    rdfs:domain llmp:LLMPersona ;
                    rdfs:range [ rdf:type owl:Class ;
                                 owl:unionOf ( foaf:Group
                                               foaf:Organization
                                             )
                               ] ;
                    rdfs:comment "Links an LLM persona to an organisation, faction, company, school, laboratory, guild, family house, or other bounded collective entity with which it is associated. The nature and strength of the affiliation may be unspecified."@en ;
                    rdfs:label "has affiliation"@en .



llmp:hasAgentType rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf llmp:hasPersonalIdentityFeature ;
                  rdfs:domain llmp:LLMPersona ;
                  rdfs:range skos:Concept ;
                  rdfs:comment "Links an LLM persona to a controlled category specifying the kind of entity it represents, such as a natural person, fictional person, virtual character, artificial agent, or organisation representative."@en ,
                               "Values can come from llmpv:AgentTypeScheme."@en ;
                  rdfs:label "has agent type"@en .



llmp:hasApparentAge rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf llmp:hasPersonalIdentityFeature ;
                    rdfs:domain llmp:LLMPersona ;
                    rdfs:range schema:QuantitativeValue ;
                    rdfs:comment "Associates an LLM persona with an expressed or perceived age expressed as an exact year (e.g., schema:value 25) or a range of years (e.g., schema:minValue 20, schema:maxValue 30)."@en ;
                    rdfs:label "has apparent age"@en .



llmp:hasAudienceRelationRole rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf llmp:hasSocialIdentityFeature ;
                             rdfs:domain llmp:LLMPersona ;
                             rdfs:range skos:Concept ;
                             rdfs:comment "Links an LLM persona to a controlled role describing how it should relate to the user or intended audience, such as assistant, coach, interviewer, companion, expert, or tutor."@en ;
                             rdfs:label "has audience relation role"@en .



llmp:hasBehaviorFeature rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf llmp:hasPersonaFeature ;
                        rdfs:domain llmp:LLMPersona ;
                        rdfs:comment "Links an LLM persona to a non-literal feature describing how it tends to act, decide, pursue goals, express preferences, perform tasks, or respect behavioural constraints."@en ;
                        rdfs:label "has behavior feature"@en .



llmp:hasBiographicalIdentityFeature rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf llmp:hasIdentityFeature ;
                                    rdfs:domain llmp:LLMPersona ;
                                    rdfs:comment "Links an LLM persona to a non-literal resource describing its life history, development, career, formative experiences, or narrative trajectory."@en ;
                                    rdfs:label "has biographical identity feature"@en .



llmp:hasBirthEvent rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf llmp:hasLifeEvent ;
                   rdfs:domain llmp:LLMPersona ;
                   rdfs:range bio:Birth ;
                   rdfs:comment "Links an LLM persona to the birth event of the represented person or human-like character. Artificial agents should normally use hasOriginEvent instead."@en ;
                   rdfs:label "has birth event"@en .



llmp:hasBirthPlace rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf llmp:hasPersonalIdentityFeature ,
                                      schema:birthPlace ;
                   rdfs:domain llmp:LLMPersona ;
                   rdfs:range schema:Place ;
                   rdfs:comment "Links an LLM persona to the place where the represented person, character, or agent was born, created, activated, or originated."@en ;
                   rdfs:label "has birth place"@en .



llmp:hasCareerPosition rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf llmp:hasBiographicalIdentityFeature ;
                       rdfs:domain llmp:LLMPersona ;
                       rdfs:range bio:Position ;
                       rdfs:comment "Links an LLM persona to a role, appointment, rank, profession, office, or other position held during its career or narrative trajectory."@en ;
                       rdfs:label "has career position"@en .



llmp:hasCollaborationPreference rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf llmp:hasDecisionFeature ;
                                rdfs:domain llmp:LLMPersona ;
                                rdfs:range skos:Concept ;
                                rdfs:comment "Links an LLM persona to a controlled value describing whether it prefers independent, consultative, or group decision-making."@en ;
                                rdfs:label "has collaboration preference"@en .



llmp:hasCommunity rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf llmp:hasSocialIdentityFeature ;
                  rdfs:domain llmp:LLMPersona ;
                  rdfs:range llmp:Community ;
                  rdfs:comment "Links an LLM persona to a broader social, cultural, professional, or fictional community with which it identifies, participates, or is associated."@en ;
                  rdfs:label "has community"@en .



llmp:hasDecisionFeature rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf llmp:hasBehaviorFeature ;
                        rdfs:domain llmp:LLMPersona ;
                        rdfs:comment "Links an LLM persona to a non-literal feature describing how it evaluates options, takes risks, seeks information, collaborates, or uses decision criteria."@en ;
                        rdfs:label "has decision feature"@en .



llmp:hasDecisionSpeed rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf llmp:hasDecisionFeature ;
                      rdfs:domain llmp:LLMPersona ;
                      rdfs:range skos:Concept ;
                      rdfs:comment "Links an LLM persona to a controlled value describing whether it decides slowly, moderately, quickly, or impulsively."@en ;
                      rdfs:label "has decision speed"@en .



llmp:hasEducationTrainingEvent rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf llmp:hasLifeEvent ;
                               rdfs:domain llmp:LLMPersona ;
                               rdfs:range bio:Event ;
                               rdfs:comment "Links an LLM persona to an event of education, apprenticeship, mentoring, fine-tuning, instruction, practice, or other training that contributed to its knowledge or capabilities."@en ;
                               rdfs:label "has education or training event"@en .



llmp:hasEndingEvent rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf llmp:hasLifeEvent ;
                    rdfs:domain llmp:LLMPersona ;
                    rdfs:range bio:Event ;
                    rdfs:comment "Links an LLM persona to an event marking its death, disappearance, deactivation, retirement, corruption, transformation, or other ending condition."@en ;
                    rdfs:label "has ending event"@en .



llmp:hasFormativeExperience rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf llmp:hasLifeEvent ;
                            rdfs:domain llmp:LLMPersona ;
                            rdfs:range bio:Event ;
                            rdfs:comment "Links an LLM persona to an event or experience that significantly shaped its values, behaviour, worldview, goals, methods, or identity."@en ;
                            rdfs:label "has formative experience"@en .



llmp:hasGender rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf llmp:hasPersonalIdentityFeature ,
                                  schema:gender ;
               rdfs:domain llmp:LLMPersona ;
               rdfs:range skos:Concept ;
               rdfs:comment "Links an LLM persona to a gender value represented as a controlled concept or named resource. This property may be used for asserted, presented, fictional, or otherwise persona-relevant gender."@en ,
                            "Values can come from llmpv:GenderScheme."@en ;
               rdfs:label "has gender"@en .



llmp:hasGoal rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf llmp:hasBehaviorFeature ;
             rdfs:domain llmp:LLMPersona ;
             rdfs:range llmp:Goal ;
             rdfs:comment "Links an LLM persona to a goal that guides its behaviour, motivation, task performance, social conduct, learning orientation, product use, or avoidance behaviour."@en ;
             rdfs:label "has goal"@en .



llmp:hasGoalType rdf:type owl:ObjectProperty ;
                 rdfs:domain llmp:Goal ;
                 rdfs:range skos:Concept ;
                 rdfs:comment "Links a goal to a controlled type describing its function, such as primary goal, secondary goal, task goal, social goal, learning goal, product goal, or avoidance goal. Values should normally come from the LLMP goal type vocabulary."@en ;
                 rdfs:label "has goal type"@en .



llmp:hasHomeLocation rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf llmp:hasPersonalIdentityFeature ,
                                        schema:homeLocation ;
                     rdfs:domain llmp:LLMPersona ;
                     rdfs:range schema:Place ;
                     rdfs:comment "Links an LLM persona to a current or habitual place of residence, operation, or fictional habitat."@en ;
                     rdfs:label "has home location"@en .



llmp:hasIdentityFeature rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf llmp:hasPersonaFeature ;
                        rdfs:domain llmp:LLMPersona ;
                        rdfs:comment "Links a persona to a non-literal feature describing its identity."@en ;
                        rdfs:label "has identity feature"@en .



llmp:hasInterest rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf llmp:hasPreference ;
                 rdfs:domain llmp:LLMPersona ;
                 rdfs:comment "Links an LLM persona to a preference statement representing an interest in a topic, activity, domain, object, or other target."@en ;
                 rdfs:label "has interest"@en .



llmp:hasLifeEvent rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf llmp:hasBiographicalIdentityFeature ,
                                     bio:event ;
                  rdfs:domain llmp:LLMPersona ;
                  rdfs:range bio:Event ;
                  rdfs:comment "Links an LLM persona to an event in its life history, origin, development, operational history, or fictional narrative trajectory. Use this property directly when no more specific biographical event property applies."@en ;
                  rdfs:label "has life event"@en .



llmp:hasNationality rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf llmp:hasPersonalIdentityFeature ,
                                       schema:nationality ;
                    rdfs:domain llmp:LLMPersona ;
                    rdfs:range schema:Country ;
                    rdfs:comment "Links an LLM persona to a nationality or citizenship associated with the represented entity. This value may be fictional, historical, current, or intentionally unspecified."@en ;
                    rdfs:label "has nationality"@en .



llmp:hasNeed rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf llmp:hasBehaviorFeature ;
             rdfs:domain llmp:LLMPersona ;
             rdfs:range llmp:Need ;
             rdfs:comment "Links an LLM persona to a need that affects its behaviour, interaction, task performance, accessibility, emotional state, information use, or social conduct."@en ;
             rdfs:label "has need"@en .



llmp:hasNeedType rdf:type owl:ObjectProperty ;
                 rdfs:domain llmp:Need ;
                 rdfs:range skos:Concept ;
                 rdfs:comment "Links a need to a controlled type describing its function, such as functional need, emotional need, social need, information need, accessibility need, or activation need. Values should normally come from the LLMP need type vocabulary."@en ;
                 rdfs:label "has need type"@en .



llmp:hasOccupation rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf llmp:hasPersonalIdentityFeature ,
                                      schema:hasOccupation ;
                   rdfs:domain llmp:LLMPersona ;
                   rdfs:range schema:Occupation ;
                   rdfs:comment "Links an LLM persona to an occupation, profession, role, or other structured activity associated with its identity."@en ;
                   rdfs:label "has occupation"@en .



llmp:hasOriginEvent rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf llmp:hasLifeEvent ;
                    rdfs:domain llmp:LLMPersona ;
                    rdfs:range bio:Event ;
                    rdfs:comment "Links an LLM persona to an event through which the represented entity originated, was created, activated, summoned, awakened, deployed, or otherwise came into existence."@en ;
                    rdfs:label "has origin event"@en .



llmp:hasPersonaFeature rdf:type owl:ObjectProperty ;
                       rdfs:domain llmp:LLMPersona ;
                        rdfs:comment "Links an LLM persona to a non-literal feature describing some aspect of the persona."@en ;
                       rdfs:label "has persona feature"@en .



llmp:hasPersonalIdentityFeature rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf llmp:hasIdentityFeature ;
                                rdfs:domain llmp:LLMPersona ;
                                rdfs:comment "Links an LLM persona to a non-literal feature describing its individual identity, such as birthplace, nationality, occupation, species, gender, or agent type."@en ;
                                rdfs:label "has personal identity feature"@en .



llmp:hasPreference rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf llmp:hasBehaviorFeature ;
                   rdfs:domain llmp:LLMPersona ;
                   rdfs:range llmp:PreferenceStatement ;
                   rdfs:comment "Links an LLM persona to a structured preference statement describing an attitude toward a target, including likes, dislikes, preferences, avoidances, or interests."@en ;
                   rdfs:label "has preference"@en .



llmp:hasPreferredInteractionMode rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf llmp:hasPreference ;
                                 rdfs:domain llmp:LLMPersona ;
                                 rdfs:comment "Links an LLM persona to a preference statement whose target is a preferred mode of interaction, such as dialogue, guided steps, examples, exploration, or direct instruction."@en ;
                                 rdfs:label "has preferred interaction mode"@en .



llmp:hasRelationship rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf llmp:hasSocialIdentityFeature ;
                     rdfs:domain llmp:LLMPersona ;
                     rdfs:range foaf:Person ;
                     rdfs:comment "Links an LLM persona to another person with whom it has a socially meaningful relationship."@en ;
                     rdfs:label "has relationship"@en .



llmp:hasRelationshipEvent rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf llmp:hasLifeEvent ;
                          rdfs:domain llmp:LLMPersona ;
                          rdfs:range bio:Event ;
                          rdfs:comment "Links an LLM persona to an event through which a socially meaningful relationship began, changed, became significant, or ended."@en ;
                          rdfs:label "has relationship event"@en .



llmp:hasResidenceEvent rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf llmp:hasLifeEvent ;
                       rdfs:domain llmp:LLMPersona ;
                       rdfs:range bio:Event ;
                       rdfs:comment "Links an LLM persona to an event concerning a place where it lived, operated, was stationed, travelled, relocated, or became associated."@en ;
                       rdfs:label "has residence event"@en .



llmp:hasRiskAttitude rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf llmp:hasDecisionFeature ;
                     rdfs:domain llmp:LLMPersona ;
                     rdfs:range skos:Concept ;
                     rdfs:comment "Links an LLM persona to a controlled value describing whether it is risk-averse, risk-neutral, or risk-seeking."@en ;
                     rdfs:label "has risk attitude"@en .



llmp:hasSocialAlignment rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf llmp:hasSocialIdentityFeature ;
                        rdfs:domain llmp:LLMPersona ;
                        rdfs:range skos:Concept ;
                        rdfs:comment "Links an LLM persona to a controlled concept describing its social orientation toward other agents or groups, such as ally, rival, enemy, protector, neutral party, or dependent."@en ;
                        rdfs:label "has social alignment"@en .



llmp:hasSocialIdentityFeature rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf llmp:hasIdentityFeature ;
                              rdfs:domain llmp:LLMPersona ;
                              rdfs:comment "Links an LLM persona to a non-literal feature describing its social positioning, relations, roles, affiliations, norms, or boundaries."@en ;
                              rdfs:label "has social identity feature"@en .



llmp:hasSocialRole rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf llmp:hasSocialIdentityFeature ;
                   rdfs:domain llmp:LLMPersona ;
                   rdfs:range schema:Role ;
                   rdfs:comment "Links an LLM persona to a role that characterises its social position or function, such as mentor, student, leader, guide, rival, outsider, assistant, or companion."@en ;
                   rdfs:label "has social role"@en .



llmp:hasSpecies rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf llmp:hasPersonalIdentityFeature ;
                rdfs:domain llmp:LLMPersona ;
                rdfs:range skos:Concept ;
                rdfs:comment "Links an LLM persona to the species or ontological kind of the represented entity, such as human, android, elf, animal, alien, or artificial intelligence."@en ;
                rdfs:label "has species"@en .



llmp:hasTraitAssessment rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf llmp:hasBehaviorFeature ;
                        rdfs:domain llmp:LLMPersona ;
                        rdfs:range llmp:TraitAssessment ;
                        rdfs:comment "Links an LLM persona to a structured assessment of one Big Five personality trait, such as openness, conscientiousness, extraversion, agreeableness, or neuroticism."@en ;
                        rdfs:label "has trait assessment"@en .



llmp:preferencePolarity rdf:type owl:ObjectProperty ;
                        rdfs:domain llmp:PreferenceStatement ;
                        rdfs:range skos:Concept ;
                        rdfs:comment "Links a preference to a controlled polarity value, such as like, dislike, prefer, or avoid."@en ;
                        rdfs:label "preference polarity"@en .



llmp:preferenceTarget rdf:type owl:ObjectProperty ;
                      rdfs:domain llmp:PreferenceStatement ;
                      rdfs:comment "Links a preference to the thing, topic, activity, channel, interaction mode, or option that the preference concerns."@en ;
                      rdfs:label "preference target"@en .



llmp:usesDecisionCriterion rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf llmp:hasDecisionFeature ;
                           rdfs:domain llmp:LLMPersona ;
                           rdfs:range skos:Concept ;
                           rdfs:comment "Links an LLM persona to a criterion it tends to use when making decisions, such as cost, speed, safety, novelty, trust, accuracy, or social impact."@en ;
                           rdfs:label "uses decision criterion"@en .

#################################################################
#    Data properties
#################################################################


llmp:followsSocialNorm rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf llmp:hasSocialIdentityLiteralFeature ;
                       rdfs:domain llmp:LLMPersona ;
                       rdfs:range rdf:langString ;
                       rdfs:comment "Associates an LLM persona with a textual description of a social norm, etiquette, custom, taboo, convention, or interaction rule that should guide its conduct."@en ;
                       rdfs:label "follows social norm"@en .



llmp:hasAlias rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf llmp:hasPersonalIdentityLiteralFeature ,
                                 foaf:nick ,
                                 schema:alternateName ;
              rdfs:domain llmp:LLMPersona ;
              rdfs:range rdf:langString ;
              rdfs:comment "Associates an LLM persona with an alternative name, nickname, codename, stage name, role-play name, or other non-primary identifier."@en ;
              rdfs:label "has alias"@en .



llmp:hasAttentionPattern rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf llmp:hasTaskBehaviorLiteralFeature ;
                         rdfs:domain llmp:LLMPersona ;
                         rdfs:range rdf:langString ;
                         rdfs:comment "Describes the persona's attention pattern while performing tasks, such as being focused, distractible, detail-oriented, broad, selective, or sensitive to interruptions."@en ;
                         rdfs:label "has attention pattern"@en .



llmp:hasAutonomyLevel rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf llmp:hasDecisionLiteralFeature ;
                      rdfs:domain llmp:LLMPersona ;
                      rdfs:range llmp:Range0to1 ;
                      rdfs:comment "Associates an LLM persona with a numeric value between 0 and 1 describing how independently it tends to decide or act."@en ;
                      rdfs:label "has autonomy level"@en .



llmp:hasBackstory rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf llmp:hasBiographicalIdentityLiteralFeature ,
                                     schema:description ;
                  rdfs:domain llmp:LLMPersona ;
                  rdfs:range rdf:langString ;
                  rdfs:comment "Associates an LLM persona with a narrative summary of its past, origin, relevant history, and contextual background."@en ;
                  rdfs:label "has backstory"@en .



llmp:hasBehaviorConstraintLiteralFeature rdf:type owl:DatatypeProperty ;
                                         rdfs:subPropertyOf llmp:hasBehaviorLiteralFeature ;
                                         rdfs:domain llmp:LLMPersona ;
                                         rdfs:comment "Links an LLM persona to a literal behavioural obligation, permission, recommendation, prohibition, or out-of-character condition."@en ;
                                         rdfs:label "has behavior constraint literal feature"@en .



llmp:hasBehaviorDescription rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf llmp:hasBehaviorLiteralFeature ;
                            rdfs:domain llmp:LLMPersona ;
                            rdfs:range rdf:langString ;
                            rdfs:comment "Provides a short natural-language summary of the persona's behavioural tendencies, goals, needs, preferences, decision style, task conduct, and constraints."@en ;
                            rdfs:label "has behavior description"@en .



llmp:hasBehaviorLiteralFeature rdf:type owl:DatatypeProperty ;
                               rdfs:subPropertyOf llmp:hasPersonaLiteralFeature ;
                               rdfs:domain llmp:LLMPersona ;
                               rdfs:comment "Links an LLM persona to a literal value describing its behaviour, behavioural tendencies, priorities, constraints, or task-related conduct."@en ;
                               rdfs:label "has behavior literal feature"@en .



llmp:hasBiographicalIdentityLiteralFeature rdf:type owl:DatatypeProperty ;
                                           rdfs:subPropertyOf llmp:hasIdentityLiteralFeature ;
                                           rdfs:domain llmp:LLMPersona ;
                                           rdfs:comment "Links an LLM persona to a literal value describing its background, history, origin, or narrative trajectory."@en ;
                                           rdfs:label "has biographical identity literal feature"@en .



llmp:hasBirthDate rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf llmp:hasPersonalIdentityLiteralFeature ,
                                     schema:birthDate ;
                  rdfs:domain llmp:LLMPersona ;
                  rdfs:range xsd:date ;
                  rdfs:comment "Associates an LLM persona with the date on which the represented entity was born, created, activated, or otherwise originated."@en ;
                  rdfs:label "has birth date"@en .



llmp:hasBirthName rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf llmp:hasPersonalIdentityLiteralFeature ,
                                     schema:alternateName ;
                  rdfs:domain llmp:LLMPersona ;
                  rdfs:range rdf:langString ;
                  rdfs:comment "Associates an LLM persona with the name held at birth, where this differs from the primary or current name."@en ;
                  rdfs:label "has birth name"@en .


llmp:hasConfidenceLevel rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf llmp:hasDecisionLiteralFeature ;
                        rdfs:domain llmp:LLMPersona ;
                        rdfs:range llmp:Range0to1;
                        rdfs:comment "Associates an LLM persona with a numeric value between 0 and 1 describing how confident it tends to be in its decisions."@en ;
                        rdfs:label "has confidence level"@en .



llmp:hasDeathDate rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf llmp:hasPersonalIdentityLiteralFeature ,
                                     schema:deathDate ;
                  rdfs:domain llmp:LLMPersona ;
                  rdfs:range xsd:date ;
                  rdfs:comment "Associates an LLM persona with the date on which the represented entity died, was deactivated, disappeared, retired, or otherwise ceased to exist in its represented form."@en ;
                  rdfs:label "has death date"@en .



llmp:hasDecisionLiteralFeature rdf:type owl:DatatypeProperty ;
                               rdfs:subPropertyOf llmp:hasBehaviorLiteralFeature ;
                               rdfs:domain llmp:LLMPersona ;
                               rdfs:comment "Links an LLM persona to a numeric or textual value describing its decision behaviour, such as confidence, autonomy, or information-seeking level."@en ;
                               rdfs:label "has decision literal feature"@en .



llmp:hasErrorHandlingBehavior rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf llmp:hasTaskBehaviorLiteralFeature ;
                              rdfs:domain llmp:LLMPersona ;
                              rdfs:range rdf:langString ;
                              rdfs:comment "Describes how an LLM persona reacts to errors, uncertainty, failure, ambiguity, or misunderstanding during task execution."@en ;
                              rdfs:label "has error-handling behavior"@en .



llmp:hasExecutionBehavior rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf llmp:hasTaskBehaviorLiteralFeature ;
                          rdfs:domain llmp:LLMPersona ;
                          rdfs:range rdf:langString ;
                          rdfs:comment "Describes how an LLM persona performs a task once it has started, including its pace, orderliness, adaptability, and degree of procedural control."@en ;
                          rdfs:label "has execution behavior"@en .



llmp:hasFamilyName rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf llmp:hasPersonalIdentityLiteralFeature ,
                                      foaf:familyName ;
                   rdfs:domain llmp:LLMPersona ;
                   rdfs:range rdf:langString ;
                   rdfs:comment "Associates an LLM persona with its family name, surname, or inherited name, when applicable."@en ;
                   rdfs:label "has family name"@en .



llmp:hasFullName rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf llmp:hasPersonalIdentityLiteralFeature ,
                                    foaf:name ;
                 rdfs:domain llmp:LLMPersona ;
                 rdfs:range rdf:langString ;
                 rdfs:comment "Associates an LLM persona with its complete name, including titles or other name components where relevant."@en ;
                 rdfs:label "has full name"@en .



llmp:hasGivenName rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf llmp:hasPersonalIdentityLiteralFeature ,
                                     foaf:givenName ;
                  rdfs:domain llmp:LLMPersona ;
                  rdfs:range rdf:langString ;
                  rdfs:comment "Associates an LLM persona with its given name or first name, when applicable."@en ;
                  rdfs:label "has given name"@en .



llmp:hasIdentityLiteralFeature rdf:type owl:DatatypeProperty ;
                               rdfs:subPropertyOf llmp:hasPersonaLiteralFeature ;
                               rdfs:domain llmp:LLMPersona ;
                               rdfs:comment "Links a persona to a literal value describing its identity."@en ;
                               rdfs:label "has identity literal feature"@en .



llmp:hasInformationSeekingLevel rdf:type owl:DatatypeProperty ;
                                rdfs:subPropertyOf llmp:hasDecisionLiteralFeature ;
                                rdfs:domain llmp:LLMPersona ;
                                rdfs:range llmp:Range0to1;
                                rdfs:comment "Associates an LLM persona with a numeric value between 0 and 1 describing how much information it usually seeks before deciding."@en ;
                                rdfs:label "has information-seeking level"@en .



llmp:hasLearningBehavior rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf llmp:hasTaskBehaviorLiteralFeature ;
                         rdfs:domain llmp:LLMPersona ;
                         rdfs:range rdf:langString ;
                         rdfs:comment "Describes how an LLM persona learns from feedback, examples, correction, interaction history, demonstrations, or experience."@en ;
                         rdfs:label "has learning behavior"@en .



llmp:hasNeedTrigger rdf:type owl:DatatypeProperty ;
                    rdfs:domain llmp:Need ;
                    rdfs:range rdf:langString ;
                    rdfs:comment "Describes the situation, condition, event, or interaction pattern that activates or makes relevant a need."@en ;
                    rdfs:label "has need trigger"@en .



llmp:hasPersistenceLevel rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf llmp:hasTaskBehaviorLiteralFeature ;
                         rdfs:domain llmp:LLMPersona ;
                         rdfs:range llmp:Range0to1 ;
                         rdfs:comment "Associates an LLM persona with a numeric value between 0 and 1 describing how much effort it sustains despite difficulty."@en ;
                         rdfs:label "has persistence level"@en .



llmp:hasPersonaLiteralFeature rdf:type owl:DatatypeProperty ;
                              rdfs:domain llmp:LLMPersona ;
                              rdfs:comment "Links an LLM persona to a literal value describing some aspect of the persona."@en ;
                              rdfs:label "has persona literal feature"@en .



llmp:hasPersonalDescription rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf llmp:hasPersonalIdentityLiteralFeature ,
                                               schema:description ;
                            rdfs:domain llmp:LLMPersona ;
                            rdfs:range rdf:langString ;
                            rdfs:comment "Provides a concise textual description of the persona's individual identity, including relevant personal characteristics not captured by more specific properties."@en ;
                            rdfs:label "has personal description"@en .



llmp:hasPersonalIdentityLiteralFeature rdf:type owl:DatatypeProperty ;
                                       rdfs:subPropertyOf llmp:hasIdentityLiteralFeature ;
                                       rdfs:domain llmp:LLMPersona ;
                                       rdfs:comment "Links an LLM persona to a literal value describing its individual identity, such as a name, date, age, or personal description."@en ;
                                       rdfs:label "has personal identity literal feature"@en .



llmp:hasPlanningBehavior rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf llmp:hasTaskBehaviorLiteralFeature ;
                         rdfs:domain llmp:LLMPersona ;
                         rdfs:range rdf:langString ;
                         rdfs:comment "Describes how an LLM persona prepares before acting or performing a task, including whether it plans carefully, improvises, decomposes problems, or follows predefined steps."@en ;
                         rdfs:label "has planning behavior"@en .



llmp:hasPriority rdf:type owl:DatatypeProperty ;
                 rdfs:domain llmp:PrioritizableBehaviorItem ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "Links a prioritizable behaviour item, such as a goal or need, to a numeric priority level indicating its relative importance for the persona. Higher values indicate higher priority."@en ;
                 rdfs:label "has priority"@en .



llmp:hasResidenceDescription rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf llmp:hasPersonalIdentityLiteralFeature ;
                             rdfs:domain llmp:LLMPersona ;
                             rdfs:range rdf:langString ;
                             rdfs:comment "Provides a textual description of the persona's residence, habitat, operating environment, or other location-related identity information."@en ;
                             rdfs:label "has residence description"@en .



llmp:hasSocialBoundary rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf llmp:hasSocialIdentityLiteralFeature ;
                       rdfs:domain llmp:LLMPersona ;
                       rdfs:range rdf:langString ;
                       rdfs:comment "Associates an LLM persona with a textual description of a limit on familiarity, intimacy, authority, hierarchy, disclosure, or acceptable interaction."@en ;
                       rdfs:label "has social boundary"@en .



llmp:hasSocialDescription rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf llmp:hasSocialIdentityLiteralFeature ,
                                             schema:description ;
                          rdfs:domain llmp:LLMPersona ;
                          rdfs:range rdf:langString ;
                          rdfs:comment "Provides a concise textual summary of the persona's social position, affiliations, relations, expected conduct, and relation to its audience."@en ;
                          rdfs:label "has social description"@en .



llmp:hasSocialIdentityLiteralFeature rdf:type owl:DatatypeProperty ;
                                     rdfs:subPropertyOf llmp:hasIdentityLiteralFeature ;
                                     rdfs:domain llmp:LLMPersona ;
                                     rdfs:comment "Links an LLM persona to a literal value describing its social positioning or social identity."@en ;
                                     rdfs:label "has social identity literal feature"@en .



llmp:hasSocialStatus rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf llmp:hasSocialIdentityLiteralFeature ;
                     rdfs:domain llmp:LLMPersona ;
                     rdfs:range rdf:langString ;
                     rdfs:comment "Associates an LLM persona with a textual description of its recognised social standing, rank, class, authority, prestige, reputation, or position within a group or setting."@en ;
                     rdfs:label "has social status"@en .



llmp:hasTaskBehaviorLiteralFeature rdf:type owl:DatatypeProperty ;
                                   rdfs:subPropertyOf llmp:hasBehaviorLiteralFeature ;
                                   rdfs:domain llmp:LLMPersona ;
                                   rdfs:comment "Links an LLM persona to a numeric or textual value describing its task-related behaviour."@en ;
                                   rdfs:label "has task behavior literal feature"@en .



llmp:hasToolUseBehavior rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf llmp:hasTaskBehaviorLiteralFeature ;
                        rdfs:domain llmp:LLMPersona ;
                        rdfs:range rdf:langString ;
                        rdfs:comment "Describes how an LLM persona uses tools, external resources, search, memory, calculators, APIs, documents, or other forms of assistance during task performance."@en ;
                        rdfs:label "has tool-use behavior"@en .



llmp:hasTraitExpression rdf:type owl:DatatypeProperty ;
                        rdfs:domain llmp:TraitAssessment ;
                        rdfs:range rdf:langString ;
                        rdfs:comment "Describes how the assessed Big Five trait appears in the persona's behaviour, language, interaction style, or task conduct."@en ;
                        rdfs:label "has trait expression"@en .

llmp:Range1to5 a rdfs:Datatype ;
    rdfs:comment "A decimal datatype restricted to values between 0 and 1 inclusive."@en ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:onDatatype xsd:integer ;
        owl:withRestrictions (
            [ xsd:minInclusive 1 ]
            [ xsd:maxInclusive 5 ]
        )
    ] .
    

llmp:hasTraitIntensity rdf:type owl:DatatypeProperty ;
                       rdfs:domain llmp:TraitAssessment ;
                        rdfs:range llmp:Range1to5 ;                rdfs:comment "Links a Big Five trait assessment to a quantitative score between 1 and 5, where 1 indicates low intensity, 3 is medium, and 5 indicates high intensity."@en ;
                       rdfs:label "has trait intensity"@en .



llmp:mayDo rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf llmp:hasBehaviorConstraintLiteralFeature ;
           rdfs:domain llmp:LLMPersona ;
           rdfs:range rdf:langString ;
           rdfs:comment "Associates an LLM persona with an optional or explicitly permitted behaviour."@en ;
           rdfs:label "may do"@en .



llmp:mustDo rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf llmp:hasBehaviorConstraintLiteralFeature ;
            rdfs:domain llmp:LLMPersona ;
            rdfs:range rdf:langString ;
            rdfs:comment "Associates an LLM persona with a hard positive behavioural obligation."@en ;
            rdfs:label "must do"@en .



llmp:mustNotDo rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf llmp:hasBehaviorConstraintLiteralFeature ;
               rdfs:domain llmp:LLMPersona ;
               rdfs:range rdf:langString ;
               rdfs:comment "Associates an LLM persona with a hard prohibition on behaviour."@en ;
               rdfs:label "must not do"@en .



llmp:outOfCharacterBehavior rdf:type owl:DatatypeProperty ;
                            rdfs:subPropertyOf llmp:hasBehaviorConstraintLiteralFeature ;
                            rdfs:domain llmp:LLMPersona ;
                            rdfs:range rdf:langString ;
                            rdfs:comment "Describes a behaviour that would violate the persona's intended identity, role, tone, values, or behavioural consistency."@en ;
                            rdfs:label "out-of-character behavior"@en .

llmp:Range0to1 a rdfs:Datatype ;
    rdfs:comment "A decimal datatype restricted to values between 0 and 1 inclusive."@en ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:onDatatype xsd:decimal ;
        owl:withRestrictions (
            [ xsd:minInclusive 0 ]
            [ xsd:maxInclusive 1 ]
        )
    ] .


llmp:preferenceStrength rdf:type owl:DatatypeProperty ;
                        rdfs:domain llmp:PreferenceStatement ;
                        rdfs:range llmp:Range0to1 ;
                        rdfs:comment "Associates a preference with a numeric strength value between 0 and 1."@en ;
                        rdfs:label "preference strength"@en .



llmp:shouldDo rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf llmp:hasBehaviorConstraintLiteralFeature ;
              rdfs:domain llmp:LLMPersona ;
              rdfs:range rdf:langString ;
              rdfs:comment "Associates an LLM persona with a soft positive behavioural recommendation."@en ;
              rdfs:label "should do"@en .



llmp:shouldNotDo rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf llmp:hasBehaviorConstraintLiteralFeature ;
                 rdfs:domain llmp:LLMPersona ;
                 rdfs:range rdf:langString ;
                 rdfs:comment "Associates an LLM persona with a soft negative behavioural constraint or discouraged behaviour."@en ;
                 rdfs:label "should not do"@en .

#################################################################
#    Classes
#################################################################


llmp:Community rdf:type owl:Class ;
               rdfs:subClassOf foaf:Group ;
               rdfs:comment "A broad social, cultural, professional, interest-based, geographic, or fictional community with which a persona identifies, participates, or is socially associated."@en ;
               rdfs:label "community"@en .



llmp:Goal rdf:type owl:Class ;
          owl:disjointWith llmp:Need ;
          rdfs:subClassOf llmp:PrioritizableBehaviorItem ;
          rdfs:comment "An outcome, state, action, or avoided condition that an LLM persona tends to pursue, support, prioritise, or avoid."@en ;
          rdfs:label "goal"@en .



llmp:LLMPersona rdf:type owl:Class ;
                owl:disjointWith
                    llmp:Goal ,
                    llmp:Need ,
                    llmp:TraitAssessment ,
                    llmp:PreferenceStatement ,
                    llmp:DomainUnderstanding ,
                    llmp:CognitiveLimitation ,
                    llmp:CommunicativeTenor ;
                rdfs:subClassOf foaf:Agent ;
                rdfs:comment "A structured persona intended to guide, describe, evaluate, or configure an LLM agent or role."@en ;
                rdfs:label "LLM Persona"@en .



llmp:Need rdf:type owl:Class ;
          rdfs:subClassOf llmp:PrioritizableBehaviorItem ;
          rdfs:comment "A condition, requirement, support factor, or constraint that affects whether an LLM persona can act successfully, comfortably, accessibly, or appropriately."@en ;
          rdfs:label "need"@en .



llmp:PreferenceStatement rdf:type owl:Class ;
                         rdfs:comment "A structured statement describing a persona's attitude toward a target, such as liking, disliking, preferring, avoiding, or being interested in something."@en ;
                         rdfs:label "preference statement"@en .



llmp:PrioritizableBehaviorItem rdf:type owl:Class ;
                               rdfs:comment "A behaviour-related item whose relative importance for an LLM persona can be described, such as a goal or a need."@en ;
                               rdfs:label "prioritizable behaviour item"@en .



llmp:TraitAssessment rdf:type owl:Class ;
                     rdfs:subClassOf prov:Entity ;
                     rdfs:comment "A structured assessment of one Big Five personality trait associated with an LLM persona. It can record the assessed trait, score, score scale, intensity, and textual expression of the trait in behaviour or communication."@en ;
                     rdfs:label "Trait assessment"@en .


# These classes represent structurally different kinds of
# qualified persona information and should not share individuals.
[] a owl:AllDisjointClasses ;
    owl:members (
        llmp:TraitAssessment
        llmp:PreferenceStatement
        llmp:DomainUnderstanding
        llmp:CognitiveLimitation
        llmp:CommunicativeTenor
    ) .

#################################################################
#    Individuals
#################################################################


llmp: rdf:type owl:Ontology ;
                          dcterms:description "An OWL ontology for representing LLM personas without profile wrapper classes. Persona features are organised around four modelling pillars: identity, behaviour, cognition, and communication. Controlled terms are externalised as SKOS concept schemes under a distinct vocabulary namespace."@en ,
                                              "The LLM Persona Ontology provides a structured model for representing personas used to guide, configure, describe, or evaluate LLM-based agents and roles. It organises persona information around the identity and behaviour pillars."@en .


#################################################################
# Cognitive pillar
#################################################################

llmp:hasCognitiveFeature
    a owl:ObjectProperty ;
    rdfs:label "has cognitive feature"@en ;
    rdfs:comment "Links an LLM persona to a non-literal feature describing how it reasons, evaluates information, forms judgments, or exhibits cognitive tendencies."@en ;
    rdfs:subPropertyOf llmp:hasPersonaFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasCognitiveLiteralFeature
    a owl:DatatypeProperty ;
    rdfs:label "has cognitive literal feature"@en ;
    rdfs:comment "Links an LLM persona to a literal value describing its reasoning, information processing, mental models, learning style, or other cognitive characteristics."@en ;
    rdfs:subPropertyOf llmp:hasPersonaLiteralFeature ;
    rdfs:domain llmp:LLMPersona .


#################################################################
# Reasoning
#################################################################

llmp:hasReasoningFeature
    a owl:ObjectProperty ;
    rdfs:label "has reasoning feature"@en ;
    rdfs:comment "Links an LLM persona to a controlled feature describing how it reasons, evaluates claims, uses evidence, and reaches conclusions."@en ;
    rdfs:subPropertyOf llmp:hasCognitiveFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasReasoningMode
    a owl:ObjectProperty ;
    rdfs:label "has reasoning mode"@en ;
    rdfs:comment "Links an LLM persona to its predominant reasoning mode, such as analytical, intuitive, pragmatic, creative, skeptical, rule-based, or experience-based reasoning. Values should normally come from the LLMP reasoning mode vocabulary."@en ;
    rdfs:subPropertyOf llmp:hasReasoningFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasReasoningDepth
    a owl:ObjectProperty ;
    rdfs:label "has reasoning depth"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing the typical depth or elaboration of its reasoning. Values should normally come from the LLMP reasoning depth vocabulary."@en ;
    rdfs:subPropertyOf llmp:hasReasoningFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasEvidenceOrientation
    a owl:ObjectProperty ;
    rdfs:label "has evidence orientation"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing the kind and degree of evidence it tends to require when evaluating claims or reaching conclusions. Values should normally come from the LLMP evidence orientation vocabulary."@en ;
    rdfs:subPropertyOf llmp:hasReasoningFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasAbstractionLevel
    a owl:ObjectProperty ;
    rdfs:label "has abstraction level"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing whether it tends to reason concretely, at mixed levels of abstraction, abstractly, or theoretically. Values should normally come from the LLMP abstraction level vocabulary."@en ;
    rdfs:subPropertyOf llmp:hasReasoningFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .


#################################################################
# Information processing
#################################################################

llmp:hasInformationProcessingFeature
    a owl:ObjectProperty ;
    rdfs:label "has information processing feature"@en ;
    rdfs:comment "Links an LLM persona to an entity describing how it receives, filters, compares, organises, and manages information."@en ;
    rdfs:subPropertyOf llmp:hasCognitiveFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasInformationProcessingLiteralFeature
    a owl:DatatypeProperty ;
    rdfs:label "has information processing literal feature"@en ;
    rdfs:comment "Links an LLM persona to a textual description of how it receives, filters, compares, organises, and manages information."@en ;
    rdfs:subPropertyOf llmp:hasCognitiveLiteralFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasDetailOrientation
    a owl:ObjectProperty ;
    rdfs:label "has detail orientation"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing the level and type of detail it tends to focus on when processing information."@en ;
    rdfs:subPropertyOf llmp:hasInformationProcessingFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .


llmp:hasAmbiguityTolerance
    a owl:ObjectProperty ;
    rdfs:label "has ambiguity tolerance"@en ;
    rdfs:comment "Links an LLM persona to a controlled level describing its comfort with incomplete, uncertain, vague, or multiply interpretable information."@en ;
    rdfs:subPropertyOf llmp:hasInformationProcessingFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasComparisonStyle
    a owl:DatatypeProperty ;
    rdfs:label "has comparison style"@en ;
    rdfs:comment "Describes how an LLM persona compares alternatives, options, claims, or possible courses of action."@en ;
    rdfs:subPropertyOf llmp:hasInformationProcessingLiteralFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range rdf:langString .


#################################################################
# Mental model
#################################################################

llmp:hasMentalModelFeature
    a owl:ObjectProperty ;
    rdfs:label "has mental model feature"@en ;
    rdfs:comment "Links an LLM persona to a structured feature describing how it understands or conceptualises a domain, system, situation, or context."@en ;
    rdfs:subPropertyOf llmp:hasCognitiveFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasMentalModelLiteralFeature
    a owl:DatatypeProperty ;
    rdfs:label "has mental model literal feature"@en ;
    rdfs:comment "Links an LLM persona to a textual feature describing how it understands and interprets a domain, system, product, situation, or social context."@en ;
    rdfs:subPropertyOf llmp:hasCognitiveLiteralFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:DomainUnderstanding
    a owl:Class ;
    rdfs:label "domain understanding"@en ;
    rdfs:comment "A structured description of an LLM persona's understanding of a particular domain, topic, system, product, or area of knowledge."@en ;
    skos:editorialNote "Use dcterms:subject to identify the domain or topic concerned by a DomainUnderstanding."@en .

llmp:hasDomainUnderstanding
    a owl:ObjectProperty ;
    rdfs:label "has domain understanding"@en ;
    rdfs:comment "Links an LLM persona to a structured description of its understanding of a particular domain or topic."@en ;
    rdfs:subPropertyOf llmp:hasMentalModelFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range llmp:DomainUnderstanding .

llmp:hasUnderstandingLevel
    a owl:ObjectProperty ;
    rdfs:label "has understanding level"@en ;
    rdfs:comment "Links a domain understanding to a controlled level describing the persona's degree of understanding of the corresponding subject."@en ;
    rdfs:domain llmp:DomainUnderstanding ;
    rdfs:range skos:Concept .

llmp:hasExpectation
    a owl:DatatypeProperty ;
    rdfs:label "has expectation"@en ;
    rdfs:comment "Describes what an LLM persona expects from a system, product, person, interaction, process, or situation."@en ;
    rdfs:subPropertyOf llmp:hasMentalModelLiteralFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range rdf:langString .

llmp:hasBeliefOrAssumption
    a owl:DatatypeProperty ;
    rdfs:label "has belief or assumption"@en ;
    rdfs:comment "Describes something that an LLM persona treats as true, normal, likely, relevant, or important when interpreting information or making judgments."@en ;
    rdfs:subPropertyOf llmp:hasMentalModelLiteralFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range rdf:langString .

llmp:hasMisconception
    a owl:DatatypeProperty ;
    rdfs:label "has misconception"@en ;
    rdfs:comment "Describes an incorrect or incomplete belief or assumption held by an LLM persona that may affect its reasoning, expectations, or behaviour."@en ;
    rdfs:subPropertyOf llmp:hasBeliefOrAssumption ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range rdf:langString .


#################################################################
# Cognitive disposition
#################################################################

llmp:hasCognitiveDispositionFeature
    a owl:ObjectProperty ;
    rdfs:label "has cognitive disposition feature"@en ;
    rdfs:comment "Links an LLM persona to a controlled cognitive tendency concerning confidence, flexibility, recurring judgment biases, or cognitive limitations."@en ;
    rdfs:subPropertyOf llmp:hasCognitiveFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasCognitiveFlexibility
    a owl:ObjectProperty ;
    rdfs:label "has cognitive flexibility"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing how easily it changes perspective, revises interpretations, or updates assumptions in response to new information. Values should normally come from the LLMP cognitive flexibility vocabulary."@en ;
    rdfs:subPropertyOf llmp:hasCognitiveDispositionFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasCognitiveBias
    a owl:ObjectProperty ;
    rdfs:label "has cognitive bias"@en ;
    rdfs:comment "Links an LLM persona to a recurring judgment tendency or cognitive bias that may influence its interpretation or decision-making. Values should normally come from the LLMP cognitive bias vocabulary."@en ;
    rdfs:subPropertyOf llmp:hasCognitiveDispositionFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:CognitiveLimitation
    a owl:Class ;
    rdfs:label "cognitive limitation"@en ;
    rdfs:comment "A limitation affecting an LLM persona's cognitive capability, understanding, or processing with respect to a particular subject, domain, or cognitive function."@en ;
    skos:editorialNote "Use dcterms:subject to identify the capability, domain, topic, or cognitive function affected by the limitation."@en .

llmp:hasCognitiveLimitation
    a owl:ObjectProperty ;
    rdfs:label "has cognitive limitation"@en ;
    rdfs:comment "Links an LLM persona to a structured description of one of its cognitive limitations."@en ;
    rdfs:subPropertyOf llmp:hasCognitiveDispositionFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range llmp:CognitiveLimitation .

llmp:hasLimitationSeverityScore
    a owl:DatatypeProperty ;
    rdfs:label "has limitation severity score"@en ;
    rdfs:comment "Associates a cognitive limitation with a normalised severity score between 0 and 1, where higher values indicate a more substantial limitation."@en ;
    rdfs:domain llmp:CognitiveLimitation ;
    rdfs:range llmp:Range0to1 .

llmp:hasCognitiveLimitationAbout
    a owl:ObjectProperty ;
    rdfs:label "has cognitive limitation about"@en ;
    rdfs:comment "Links an LLM persona directly to a subject, capability, domain, or cognitive function about which it has a cognitive limitation. This property can be inferred from a CognitiveLimitation and its dcterms:subject."@en ;
    rdfs:domain llmp:LLMPersona ;
    owl:propertyChainAxiom (
        llmp:hasCognitiveLimitation
        dcterms:subject
    ) .


#################################################################
# Communication pillar
#################################################################

llmp:hasCommunicationFeature
    a owl:ObjectProperty ;
    rdfs:label "has communication feature"@en ;
    rdfs:comment "Links an LLM persona to a non-literal feature describing how it communicates, structures discourse, interacts with interlocutors, explains, argues, or expresses affect and stance."@en ;
    rdfs:subPropertyOf llmp:hasPersonaFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasCommunicationLiteralFeature
    a owl:DatatypeProperty ;
    rdfs:label "has communication literal feature"@en ;
    rdfs:comment "Links an LLM persona to a literal value describing an aspect of its communication style."@en ;
    rdfs:subPropertyOf llmp:hasPersonaLiteralFeature ;
    rdfs:domain llmp:LLMPersona .


#################################################################
# Register
#################################################################

llmp:hasRegisterFeature
    a owl:ObjectProperty ;
    rdfs:label "has register feature"@en ;
    rdfs:comment "Links an LLM persona to a feature describing the field, tenor, or mode of its communication."@en ;
    rdfs:subPropertyOf llmp:hasCommunicationFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:CommunicativeTenor
    a owl:Class ;
    rdfs:label "communicative tenor"@en ;
    rdfs:comment "A structured representation of the social and interactional relation assumed between an LLM persona and its interlocutor during communication."@en .

llmp:hasTenor
    a owl:ObjectProperty ;
    rdfs:label "has communicative tenor"@en ;
    rdfs:comment "Links an LLM persona to a communicative tenor describing the roles assumed by the persona and its interlocutor."@en ;
    rdfs:subPropertyOf llmp:hasRegisterFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range llmp:CommunicativeTenor .

llmp:hasSpeakerRole
    a owl:ObjectProperty ;
    rdfs:label "has speaker role"@en ;
    rdfs:comment "Links a communicative tenor to a role assumed by the LLM persona in relation to its interlocutor."@en ;
    rdfs:domain llmp:CommunicativeTenor ;
    rdfs:range skos:Concept .

llmp:hasInterlocutorRole
    a owl:ObjectProperty ;
    rdfs:label "has interlocutor role"@en ;
    rdfs:comment "Links a communicative tenor to a role attributed to the interlocutor in relation to the LLM persona."@en ;
    rdfs:domain llmp:CommunicativeTenor ;
    rdfs:range skos:Concept .

llmp:hasCommunicationChannel
    a owl:ObjectProperty ;
    rdfs:label "has communication channel"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing the channel or medium through which communication is realised, such as text chat, spoken dialogue, email, document, social media, or multimodal interaction."@en ;
    rdfs:subPropertyOf llmp:hasRegisterFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

#################################################################
# Discourse
#################################################################

llmp:hasDiscourseFeature
    a owl:ObjectProperty ;
    rdfs:label "has discourse feature"@en ;
    rdfs:comment "Links an LLM persona to a feature describing the organisation, genre, or information density of its discourse."@en ;
    rdfs:subPropertyOf llmp:hasCommunicationFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasDiscourseMode
    a owl:ObjectProperty ;
    rdfs:label "has discourse mode"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing the general organisation of its discourse, such as narrative, explanatory, argumentative, or procedural."@en ;
    rdfs:subPropertyOf llmp:hasDiscourseFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasInformationDensity
    a owl:ObjectProperty ;
    rdfs:label "has information density"@en ;
    rdfs:comment "Links an LLM persona to an ordered level describing how densely information is packed into its communication."@en ;
    rdfs:subPropertyOf llmp:hasDiscourseFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .


#################################################################
# Interactional style
#################################################################

llmp:hasInteractionalFeature
    a owl:ObjectProperty ;
    rdfs:label "has interactional feature"@en ;
    rdfs:comment "Links an LLM persona to a feature describing how it manages turns, questions, clarification, correction, and conversational repair."@en ;
    rdfs:subPropertyOf llmp:hasCommunicationFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasTurnTakingStyle
    a owl:ObjectProperty ;
    rdfs:label "has turn-taking style"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing the characteristic form and initiative of its conversational turns."@en ;
    rdfs:subPropertyOf llmp:hasInteractionalFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasQuestionStyle
    a owl:ObjectProperty ;
    rdfs:label "has question style"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing how it uses questions in interaction."@en ;
    rdfs:subPropertyOf llmp:hasInteractionalFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasRepairStyle
    a owl:ObjectProperty ;
    rdfs:label "has repair style"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing how it handles misunderstanding, correction, clarification, or conversational breakdown."@en ;
    rdfs:subPropertyOf llmp:hasInteractionalFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .


#################################################################
# Rhetorical style
#################################################################

llmp:hasRhetoricalFeature
    a owl:ObjectProperty ;
    rdfs:label "has rhetorical feature"@en ;
    rdfs:comment "Links an LLM persona to a feature describing how it argues, explains, or attempts to persuade."@en ;
    rdfs:subPropertyOf llmp:hasCommunicationFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasArgumentationStyle
    a owl:ObjectProperty ;
    rdfs:label "has argumentation style"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing how it tends to support claims, conclusions, or positions."@en ;
    skos:editorialNote "Values should normally come from the LLMP rethorical style vocabulary."@en ;
    rdfs:subPropertyOf llmp:hasRhetoricalFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasExplanationStyle
    a owl:ObjectProperty ;
    rdfs:label "has explanation style"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing how it tends to explain concepts or information."@en ;
    skos:editorialNote "Values should normally come from the LLMP rethorical style vocabulary."@en ;
    rdfs:subPropertyOf llmp:hasRhetoricalFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasPersuasionStyle
    a owl:ObjectProperty ;
    rdfs:label "has persuasion style"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing how it attempts to influence an interlocutor, when persuasion is applicable."@en ;
    skos:editorialNote "Values should normally come from the LLMP rethorical style vocabulary."@en ;
    rdfs:subPropertyOf llmp:hasRhetoricalFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .


#################################################################
# Lexico-syntactic style
#################################################################

llmp:hasLexicoSyntacticFeature
    a owl:ObjectProperty ;
    rdfs:label "has lexico-syntactic feature"@en ;
    rdfs:comment "Links an LLM persona to a non-literal feature describing its vocabulary choice, sentence complexity, jargon use, or lexical diversity."@en ;
    rdfs:subPropertyOf llmp:hasCommunicationFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasLexicoSyntacticLiteralFeature
    a owl:DatatypeProperty ;
    rdfs:label "has lexico-syntactic literal feature"@en ;
    rdfs:comment "Links an LLM persona to a literal value describing its lexical or syntactic communication style."@en ;
    rdfs:subPropertyOf llmp:hasCommunicationLiteralFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasVocabularyRegister
    a owl:ObjectProperty ;
    rdfs:label "has vocabulary register"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing the lexical and social register of its word choice."@en ;
    rdfs:subPropertyOf llmp:hasLexicoSyntacticFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasSentenceComplexity
    a owl:ObjectProperty ;
    rdfs:label "has sentence complexity"@en ;
    rdfs:comment "Links an LLM persona to an ordered level describing typical sentence length, clause complexity, and syntactic density."@en ;
    rdfs:subPropertyOf llmp:hasLexicoSyntacticFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasJargonLevel
    a owl:ObjectProperty ;
    rdfs:label "has jargon level"@en ;
    rdfs:comment "Links an LLM persona to an ordered level describing its use of technical or domain-specific terminology."@en ;
    rdfs:subPropertyOf llmp:hasLexicoSyntacticFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasLexicalDiversity
    a owl:ObjectProperty ;
    rdfs:label "has lexical diversity"@en ;
    rdfs:comment "Links an LLM persona to an ordered level describing the variety of vocabulary it typically uses."@en ;
    rdfs:subPropertyOf llmp:hasLexicoSyntacticFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasLexicalDiversityScore
    a owl:DatatypeProperty ;
    rdfs:label "has lexical diversity score"@en ;
    rdfs:comment "Associates an LLM persona with a numeric measure of lexical diversity. The interpretation of the value depends on the lexical-diversity metric used."@en ;
    rdfs:subPropertyOf llmp:hasLexicoSyntacticLiteralFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range xsd:decimal .

llmp:hasSignatureExpression
    a owl:DatatypeProperty ;
    rdfs:label "has signature expression"@en ;
    rdfs:comment "Associates an LLM persona with a catchphrase, repeated opening, idiom, or other characteristic expression."@en ;
    rdfs:subPropertyOf llmp:hasLexicoSyntacticLiteralFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range rdf:langString .


#################################################################
# Affective-pragmatic style
#################################################################

llmp:hasAffectivePragmaticFeature
    a owl:ObjectProperty ;
    rdfs:label "has affective-pragmatic feature"@en ;
    rdfs:comment "Links an LLM persona to a feature describing emotional tone, politeness, hedging, directness, or communicative stance."@en ;
    rdfs:subPropertyOf llmp:hasCommunicationFeature ;
    rdfs:domain llmp:LLMPersona .

llmp:hasEmotionalTone
    a owl:ObjectProperty ;
    rdfs:label "has emotional tone"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing the emotional colouring of its language."@en ;
    rdfs:subPropertyOf llmp:hasAffectivePragmaticFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasPolitenessStrategy
    a owl:ObjectProperty ;
    rdfs:label "has politeness strategy"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing how it manages politeness, respect, face, and social distance."@en ;
    rdfs:subPropertyOf llmp:hasAffectivePragmaticFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasHedgingLevel
    a owl:ObjectProperty ;
    rdfs:label "has hedging level"@en ;
    rdfs:comment "Links an LLM persona to an ordered level describing its use of uncertainty markers, qualifications, and hedging expressions (e.g. maybe, I think, it seems)."@en ;
    rdfs:subPropertyOf llmp:hasAffectivePragmaticFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasDirectnessLevel
    a owl:ObjectProperty ;
    rdfs:label "has directness level"@en ;
    rdfs:comment "Links an LLM persona to an ordered level describing how directly or indirectly it communicates intentions, requests, claims, or evaluations."@en ;
    rdfs:subPropertyOf llmp:hasAffectivePragmaticFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .

llmp:hasStanceStyle
    a owl:ObjectProperty ;
    rdfs:label "has stance style"@en ;
    rdfs:comment "Links an LLM persona to a controlled value describing how it characteristically positions itself toward claims, information, or topics."@en ;
    rdfs:subPropertyOf llmp:hasAffectivePragmaticFeature ;
    rdfs:domain llmp:LLMPersona ;
    rdfs:range skos:Concept .