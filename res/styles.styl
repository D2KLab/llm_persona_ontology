// out: ./styles.css, sourcemap: true, compress: false, libs: nib rupture

@import url('https://fonts.googleapis.com/css2?family=Sora:wght@100..800&display=swap');
@import "button"
@import "footer"

defaultFont = 'Sora', 'Roboto', 'Helvetica', 'Arial', sans-serif
monospaceFont = "Lucida Console", Monaco, monospace

// COLORS
materialYellow = #223D97
materialBlue = #2196F3

html, body
  background-color: #e5e5e5;
  margin 0

body
  font-family defaultFont

h1,h2
  font-family defaultFont

ul
  list-style none
  padding 0

a
  color materialBlue
  text-decoration none
  &:hover
    text-decoration underline


section
h1
  max-width 900px
  margin auto
  margin-top 1em


.cover
  max-width none
  color #fff
  display block
  padding 2em 2em
  +below('m')
    padding 4em 2em

  background  materialYellow url('img/background.jpg') center center no-repeat
  background-size cover

  // box-shadow inset 0 -7px 16px -12px grayDark
  margin-bottom 2em

  .inside
    display flex
    align-items center
    justify-content space-between

    max-width 900px
    margin auto

    +below('m')
      flex-direction column

  h1
    font-size 3em
    font-weight 300

  .logo
    width 15em
    height 15em
    +below('m')
      max-width 8em
      max-height 8em
      width 70vw
      height 70vw
      margin-top 2em
    img
      max-width: 100%
      max-height: 100%

.model-pics
  img
    max-width: 100%


.summary
  ul
    li
      font-size .9em
      display inline-block
      line-height 1.5em
      &:after
        content '|'
        margin 0 .3em
      &:last-of-type:after
        content none
      a
        text-decoration none
        color #555
        &:hover
          text-decoration underline
          color #333

.card
  background #fff
  border-radius 2em

  ul.list
    padding 1em 0
    > li
      margin 1em 2em
      padding 1em
      border-bottom 1px solid #999

  h2
    font-weight: 300
    margin 0
    a
      text-decoration none
      color inherit;
    span
      font-variant: small-caps
    small
      display block
      font-size: .5em
      opacity: .6
      font-family monospaceFont

  ul.features
    display table
    li
      display table-row
      margin .5em
      font-size .9em
      div
        display table-cell
        padding .5em
        vertical-align: text-top;
      .prop
        font-variant: small-caps
        opacity .8

      small
        opacity .5
        font-size .8em


.table-shell
  overflow-x auto
  border 1px solid materialYellow
  border-radius 14px

table
  width 100%
  min-width 780px
  border-collapse collapse
  table-layout fixed

col
  width 50%

thead
  th
    padding 16px 20px
    background #fafbfc
    color var(--muted)
    border-bottom 1px solid materialYellow
    font-size 0.76rem
    font-weight 750
    letter-spacing 0.08em
    text-align left
    text-transform uppercase

thead th + th,
    tbody td + td,
    tbody th + th
  border-left 1px solid materialYellow

tbody td,
    tbody th
  padding 12px 20px
  border-bottom 1px solid materialYellow
  text-align left
  vertical-align top

tbody
  &:last-child
    tr
      &:last-child
        td
          border-bottom 0
  & + tbody
    .major-row
      th
        border-top 12px solid materialBlue

.major-row
  th
    padding 14px 20px
    background materialYellow
    color #fff
    font-size 0.8rem
    letter-spacing 0.075em
  a
    color inherit
    text-decoration none

.property-cell
  position relative
  font-size 0.95rem
  &.subgroup
    background rgba(materialYellow, 0.2)
    font-size 0.79rem
    font-weight 800
    letter-spacing 0.055em
    text-transform uppercase
    .range
      text-transform none
  &.depth-1
    padding-left 38px
    &::before
      left 20px
  &.depth-2
    padding-left 58px
    &::before
      left 40px
  &.depth-3
    padding-left 78px
    &::before
      left 60px

.property-cell.depth-1::before,
    .property-cell.depth-2::before,
    .property-cell.depth-3::before
  content ""
  position absolute
  top 50%
  width 12px
  border-top 1px solid #bcc4d1
.property-cell.collapsible
  padding-left 21px !important
  &:before
    content none !important

.property-link
  color materialBlue
  font-weight 620
  text-decoration none
  &:hover
    text-decoration underline
    text-underline-offset 3px