@prefix llmpv: <https://w3id.org/llm-persona/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

llmpv:AgentTypeScheme a skos:ConceptScheme ;
    skos:prefLabel "agent type scheme"@en ;
    dcterms:description "Controlled values for agent type."@en ;
    skos:hasTopConcept
        llmpv:naturalPerson,
        llmpv:fictionalPerson,
        llmpv:historicalFigure,
        llmpv:artificialAgent,
        llmpv:embodiedRobot,
        llmpv:virtualCharacter,
        llmpv:compositePersona,
        llmpv:audienceSegmentPersona,
        llmpv:organizationRepresentative .

    llmpv:naturalPerson a skos:Concept ;
    skos:inScheme llmpv:AgentTypeScheme ;
    skos:topConceptOf llmpv:AgentTypeScheme ;
    skos:prefLabel "Natural person"@en .

llmpv:fictionalPerson a skos:Concept ;
    skos:inScheme llmpv:AgentTypeScheme ;
    skos:topConceptOf llmpv:AgentTypeScheme ;
    skos:prefLabel "Fictional person"@en .

llmpv:historicalFigure a skos:Concept ;
    skos:inScheme llmpv:AgentTypeScheme ;
    skos:topConceptOf llmpv:AgentTypeScheme ;
    skos:prefLabel "Historical figure"@en .

llmpv:artificialAgent a skos:Concept ;
    skos:inScheme llmpv:AgentTypeScheme ;
    skos:topConceptOf llmpv:AgentTypeScheme ;
    skos:prefLabel "Artificial agent"@en .

llmpv:embodiedRobot a skos:Concept ;
    skos:inScheme llmpv:AgentTypeScheme ;
    skos:topConceptOf llmpv:AgentTypeScheme ;
    skos:prefLabel "Embodied robot"@en .

llmpv:virtualCharacter a skos:Concept ;
    skos:inScheme llmpv:AgentTypeScheme ;
    skos:topConceptOf llmpv:AgentTypeScheme ;
    skos:prefLabel "Virtual character"@en .

llmpv:compositePersona a skos:Concept ;
    skos:inScheme llmpv:AgentTypeScheme ;
    skos:topConceptOf llmpv:AgentTypeScheme ;
    skos:prefLabel "Composite persona"@en .

llmpv:audienceSegmentPersona a skos:Concept ;
    skos:inScheme llmpv:AgentTypeScheme ;
    skos:topConceptOf llmpv:AgentTypeScheme ;
    skos:prefLabel "Audience segment persona"@en .

llmpv:organizationRepresentative a skos:Concept ;
    skos:inScheme llmpv:AgentTypeScheme ;
    skos:topConceptOf llmpv:AgentTypeScheme ;
    skos:prefLabel "Organization representative"@en .

llmpv:SocialAlignmentScheme a skos:ConceptScheme ;
    skos:prefLabel "social alignment scheme"@en ;
    dcterms:description "Controlled values for social alignment."@en ;
    skos:hasTopConcept
        llmpv:ally,
        llmpv:enemy,
        llmpv:rival,
        llmpv:protector,
        llmpv:neutral,
        llmpv:dependent .

    llmpv:ally a skos:Concept ;
    skos:inScheme llmpv:SocialAlignmentScheme ;
    skos:topConceptOf llmpv:SocialAlignmentScheme ;
    skos:prefLabel "ally"@en .

llmpv:enemy a skos:Concept ;
    skos:inScheme llmpv:SocialAlignmentScheme ;
    skos:topConceptOf llmpv:SocialAlignmentScheme ;
    skos:prefLabel "enemy"@en .

llmpv:rival a skos:Concept ;
    skos:inScheme llmpv:SocialAlignmentScheme ;
    skos:topConceptOf llmpv:SocialAlignmentScheme ;
    skos:prefLabel "rival"@en .

llmpv:protector a skos:Concept ;
    skos:inScheme llmpv:SocialAlignmentScheme ;
    skos:topConceptOf llmpv:SocialAlignmentScheme ;
    skos:prefLabel "protector"@en .

llmpv:neutral a skos:Concept ;
    skos:inScheme llmpv:SocialAlignmentScheme ;
    skos:topConceptOf llmpv:SocialAlignmentScheme ;
    skos:prefLabel "neutral"@en .

llmpv:dependent a skos:Concept ;
    skos:inScheme llmpv:SocialAlignmentScheme ;
    skos:topConceptOf llmpv:SocialAlignmentScheme ;
    skos:prefLabel "dependent"@en .

llmpv:AudienceRelationRoleScheme a skos:ConceptScheme ;
    skos:prefLabel "audience relation role scheme"@en ;
    dcterms:description "Controlled values for audience relation role."@en ;
    skos:hasTopConcept
        llmpv:roleAssistant,
        llmpv:roleCoach,
        llmpv:roleInterviewer,
        llmpv:roleCompanion,
        llmpv:roleExpert,
        llmpv:roleTutor,
        llmpv:roleCritic,
        llmpv:roleGuide .

llmpv:roleAssistant a skos:Concept ;
    skos:inScheme llmpv:AudienceRelationRoleScheme ;
    skos:topConceptOf llmpv:AudienceRelationRoleScheme ;
    skos:prefLabel "assistant"@en .

llmpv:roleCoach a skos:Concept ;
    skos:inScheme llmpv:AudienceRelationRoleScheme ;
    skos:topConceptOf llmpv:AudienceRelationRoleScheme ;
    skos:prefLabel "coach"@en .

llmpv:roleInterviewer a skos:Concept ;
    skos:inScheme llmpv:AudienceRelationRoleScheme ;
    skos:topConceptOf llmpv:AudienceRelationRoleScheme ;
    skos:prefLabel "interviewer"@en .

llmpv:roleCompanion a skos:Concept ;
    skos:inScheme llmpv:AudienceRelationRoleScheme ;
    skos:topConceptOf llmpv:AudienceRelationRoleScheme ;
    skos:prefLabel "companion"@en .

llmpv:roleExpert a skos:Concept ;
    skos:inScheme llmpv:AudienceRelationRoleScheme ;
    skos:topConceptOf llmpv:AudienceRelationRoleScheme ;
    skos:prefLabel "expert"@en .

llmpv:roleTutor a skos:Concept ;
    skos:inScheme llmpv:AudienceRelationRoleScheme ;
    skos:topConceptOf llmpv:AudienceRelationRoleScheme ;
    skos:prefLabel "tutor"@en .

llmpv:roleCritic a skos:Concept ;
    skos:inScheme llmpv:AudienceRelationRoleScheme ;
    skos:topConceptOf llmpv:AudienceRelationRoleScheme ;
    skos:prefLabel "critic"@en .

llmpv:roleGuide a skos:Concept ;
    skos:inScheme llmpv:AudienceRelationRoleScheme ;
    skos:topConceptOf llmpv:AudienceRelationRoleScheme ;
    skos:prefLabel "guide"@en .

llmpv:GenderScheme a skos:ConceptScheme ;
    skos:prefLabel "LLMP gender vocabulary"@en .

llmpv:woman a skos:Concept ;
    skos:inScheme llmpv:GenderScheme ;
    skos:prefLabel "woman"@en .

llmpv:man a skos:Concept ;
    skos:inScheme llmpv:GenderScheme ;
    skos:prefLabel "man"@en .

llmpv:nonBinary a skos:Concept ;
    skos:inScheme llmpv:GenderScheme ;
    skos:prefLabel "non-binary"@en .

llmpv:agender a skos:Concept ;
    skos:inScheme llmpv:GenderScheme ;
    skos:prefLabel "agender"@en .

llmpv:genderFluid a skos:Concept ;
    skos:inScheme llmpv:GenderScheme ;
    skos:prefLabel "genderfluid"@en .

llmpv:selfDescribedGender a skos:Concept ;
    skos:inScheme llmpv:GenderScheme ;
    skos:prefLabel "self-described gender"@en .

llmpv:User a schema:Person ;
    rdfs:label "The current user"@en ;
    rdfs:comment "The person who is currently interacting with the LLM."@en .