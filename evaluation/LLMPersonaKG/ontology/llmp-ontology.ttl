#################################################################
#    Individuals
#################################################################

###  http://example.org/llmp
<http://example.org/llmp> rdf:type owl:NamedIndividual ;
                          dcterms:description "An OWL ontology for representing LLM personas without profile wrapper classes. Persona features are organised around four modelling pillars: identity, behaviour, cognition, and communication. Controlled terms are externalised as SKOS concept schemes under a distinct vocabulary namespace."@en ,
                                              "The LLM Persona Ontology provides a structured model for representing personas used to guide, configure, describe, or evaluate LLM-based agents and roles. It organises persona information around the identity and behaviour pillars."@en .


