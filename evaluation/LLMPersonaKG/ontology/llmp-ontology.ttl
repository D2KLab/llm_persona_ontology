#    Classes
#################################################################

###  http://example.org/llmp#Community
llmp:Community rdf:type owl:Class ;
               rdfs:subClassOf foaf:Group ;
               rdfs:comment "A broad social, cultural, professional, interest-based, geographic, or fictional community with which a persona identifies, participates, or is socially associated."@en ;
               rdfs:label "community"@en .


###  http://example.org/llmp#Goal
llmp:Goal rdf:type owl:Class ;
          rdfs:subClassOf llmp:PrioritizableBehaviorItem ;
          rdfs:comment "An outcome, state, action, or avoided condition that an LLM persona tends to pursue, support, prioritise, or avoid."@en ;
          rdfs:label "goal"@en .


###  http://example.org/llmp#LLMPersona
llmp:LLMPersona rdf:type owl:Class ;
                rdfs:subClassOf foaf:Agent ;
                rdfs:comment "A structured persona intended to guide, describe, evaluate, or configure an LLM agent or role."@en ;
                rdfs:label "LLM Persona"@en .


###  http://example.org/llmp#Need
llmp:Need rdf:type owl:Class ;
          rdfs:subClassOf llmp:PrioritizableBehaviorItem ;
          rdfs:comment "A condition, requirement, support factor, or constraint that affects whether an LLM persona can act successfully, comfortably, accessibly, or appropriately."@en ;
          rdfs:label "need"@en .


###  http://example.org/llmp#PreferenceStatement
llmp:PreferenceStatement rdf:type owl:Class ;
                         rdfs:comment "A structured statement describing a persona's attitude toward a target, such as liking, disliking, preferring, avoiding, or being interested in something."@en ;
                         rdfs:label "preference statement"@en .


###  http://example.org/llmp#PrioritizableBehaviorItem
llmp:PrioritizableBehaviorItem rdf:type owl:Class ;
                               rdfs:comment "A behaviour-related item whose relative importance for an LLM persona can be described, such as a goal or a need."@en ;
                               rdfs:label "prioritizable behaviour item"@en .


###  http://example.org/llmp#TraitAssessment
llmp:TraitAssessment rdf:type owl:Class ;
                     rdfs:subClassOf prov:Entity ;
                     rdfs:comment "A structured assessment of one Big Five personality trait associated with an LLM persona. It can record the assessed trait, score, score scale, intensity, and textual expression of the trait in behaviour or communication."@en ;
                     rdfs:label "Trait assessment"@en .


